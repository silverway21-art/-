rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects Collection: Public read and write for real-time portfolio project management
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Site Configuration Collection: Public read and write for real-time site customization
    match /site_config/{configId} {
      allow read, write: if true;
    }

    // Contact Messages Collection: Public can create/send messages, Admin can read/update/delete
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // System Admins Collection: Strict zero-trust isolation
    // Client SDK can NEVER read or write admin hashes or accounts.
    match /system_admins/{adminId} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
